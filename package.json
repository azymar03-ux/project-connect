{
  "name": "projectconnect",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev apps/web --hostname 0.0.0.0 --port 3000",
    "api": "tsx apps/api/src/main.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "build": "next build apps/web",
    "build:api": "tsc -p apps/api/tsconfig.build.json",
    "start:api": "node artifacts/api/main.js",
    "start:web": "next start apps/web --hostname 0.0.0.0 --port 3000",
    "db:migrate": "prisma migrate deploy",
    "test:launch": "playwright test",
    "release": "node scripts/release.mjs",
    "lint": "eslint apps tests prisma",
    "format": "prettier --write apps prisma tests scripts/*.mjs",
    "format:check": "prettier --check apps prisma tests scripts/*.mjs",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "contracts:check": "node scripts/sync-contracts.mjs --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "fflate": "^0.8.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "nodemailer": "^10.0.16",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "prisma": "^6.12.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
